# Procesado por envsubst al iniciar el contenedor (imagen oficial de nginx).
# Solo se sustituyen variables de entorno definidas (API_KEY); las de nginx ($http_...) quedan intactas.

# Las claves de 64+ caracteres no caben en el bucket por defecto (64) -> nginx no arranca.
map_hash_bucket_size 256;

map $http_x_api_key $auth_ok {
    default      0;
    "${API_KEY}" 1;
    # Para más claves, agrega líneas:  "otra_clave" 1;
}

# Solo las peticiones SIN clave válida cuentan para el rate limit
# (clave vacía = nginx no la contabiliza).
map $auth_ok $badauth_key {
    0 $binary_remote_addr;
    1 "";
}
limit_req_zone $badauth_key zone=badauth:10m rate=10r/m;

map $http_upgrade $conn_upgrade {
    default upgrade;
    ""      "";
}

server {
    listen 2376 ssl;
    http2 off;                       # Docker hijack (exec/attach) requiere HTTP/1.1

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;

    server_tokens off;
    client_max_body_size 0;          # docker build / load / cp sin límite

    limit_req_status 429;

    location = /_health {
        access_log off;
        return 200 "ok\n";
    }

    # Orden de fases nginx: preaccess (limit_req) -> access (auth_request) -> content (proxy).
    # Un 'if/return' iría en la fase rewrite, ANTES de limit_req, y el rate limit nunca actuaría.
    location = /_auth {
        internal;
        if ($auth_ok = 0) { return 401; }
        return 204;
    }

    location @unauthorized {
        default_type application/json;
        return 401 '{"message":"Unauthorized"}';
    }

    location / {
        limit_req zone=badauth burst=5 nodelay;
        auth_request /_auth;
        error_page 401 = @unauthorized;

        proxy_pass http://unix:/var/run/docker.sock:;
        proxy_http_version 1.1;
        proxy_set_header Host docker;
        proxy_set_header X-Api-Key "";   # no reenviar la clave al daemon
        proxy_set_header Upgrade $http_upgrade;       # exec / attach
        proxy_set_header Connection $conn_upgrade;

        proxy_buffering off;             # logs -f, events, stats en streaming
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
